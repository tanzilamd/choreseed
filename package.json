{
  "name": "choreseed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server.js"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "fastify": "5.12.7",
    "@fastify/static": "10.1.6",
    "@fastify/cookie": "11.1.3",
    "zod": "4.6.7",
    "papaparse": "5.7.0",
    "idb": "8.0.4",
    "ws": "8.22.0",
    "https-proxy-agent": "9.1.0",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "concurrently": "10.0.6",
    "@playwright/test": "1.64.1",
    "@types/ws": "8.18.2",
    "@axe-core/playwright": "4.14.0"
  }
}
